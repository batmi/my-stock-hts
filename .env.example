# [한국투자증권 KIS API - 모의투자]
SIM_APP_KEY=your_sim_app_key_here
SIM_APP_SECRET=your_sim_app_secret_here
SIM_ACC_NUM=12345678-01

# [한국투자증권 KIS API - 실전투자]
REAL_APP_KEY=your_real_app_key_here
REAL_APP_SECRET=your_real_app_secret_here
REAL_ACC_NUM=12345678-01

# [한국투자증권 KIS API - 자동매매 전용 계좌] (선택)
AUTO_APP_KEY=your_auto_app_key_here
AUTO_APP_SECRET=your_auto_app_secret_here
AUTO_ACC_NUM=12345678-02

# [Telegram Bot]
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# [Google Gemini AI]
GEMINI_API_KEY=your_gemini_api_key_here

# [OpenDART 전자공시 API] (선택) - 국내 공시/배당/실적 조회용 (https://opendart.fss.or.kr)
DART_API_KEY=your_dart_api_key_here
# [KRX 정보데이터시스템] (선택) - 과거 일별 수급(외국인·기관 순매수) 조회용
#  https://data.krx.co.kr 회원 계정. API 키가 아니라 웹 로그인 ID/비밀번호다.
#  미설정 시 KIS 수급 TR(최근 30거래일만)로 폴백하므로, 다년 백테스트에서는
#  그 창 밖 구간의 '스마트머니' 시그널이 꺼진 것으로 계산된다.
#  ※ 비밀번호이므로 다른 곳에 쓰지 않는 전용 계정을 권한다.
KRX_ID=your_krx_id_here
KRX_PW=your_krx_password_here
