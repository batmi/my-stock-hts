# =====================================================================
#  MyStock HTS 환경 변수 예시
#  - 이 파일을 .env 로 복사해 채우거나, ~/.htsrc 에 `export KEY="값"` 형태로 등록한다.
#  - 값을 바꾼 뒤에는 셸에 다시 반영(source)하고 **프로그램을 재시작**해야 적용된다.
#    이미 떠 있는 프로세스는 새 변수를 받지 못한다.
#  - 발급 절차는 README.md '6. 환경 변수 · 외부 서비스 발급 안내' 참고.
# =====================================================================

# ---------------------------------------------------------------------
# [필수] 한국투자증권 KIS — 쓰려는 모드의 것만 채우면 된다
# ---------------------------------------------------------------------
# 모의투자 (모드 1)
SIM_APP_KEY=your_sim_app_key_here
SIM_APP_SECRET=your_sim_app_secret_here
SIM_ACC_NUM=12345678-01

# 실전투자 (모드 2)
REAL_APP_KEY=your_real_app_key_here
REAL_APP_SECRET=your_real_app_secret_here
REAL_ACC_NUM=12345678-01

# 자동매매 전용 계좌 (선택) — TPS·웹소켓·토큰 제약이 앱키 단위라 분리하면 서로 간섭하지 않는다
AUTO_APP_KEY=
AUTO_APP_SECRET=
AUTO_ACC_NUM=

# 가상투자/관찰 모드 (모드 4) — 시세만 KIS 실전에서 받고 주문은 가상 체결
#  VIRT_ACC_NUM 은 알림 꼬리말 식별용 '표시 전용'이며 매매·조회에는 쓰이지 않는다.
VIRT_APP_KEY=
VIRT_APP_SECRET=
VIRT_ACC_NUM=

# 실시간 체결통보 WebSocket 구독키 = KIS HTS 로그인 ID (선택)
#  미설정 시 체결 감지는 REST 폴링으로 폴백한다.
#  실전/모의가 같은 ID면 KIS_HTS_ID(또는 HTS_ID) 하나로 갈음 가능.
REAL_HTS_ID=
SIM_HTS_ID=

# ---------------------------------------------------------------------
# [선택] 토스증권 (모드 3)
#  ※ 토스는 '허용 IP 등록이 필수'다. 등록하지 않은 회선에서는 토큰 발급이 거부된다.
# ---------------------------------------------------------------------
TOSS_APP_KEY=
TOSS_APP_SECRET=
TOSS_ACC_NUM=

# ---------------------------------------------------------------------
# [권장] 텔레그램 봇 — 알림과 원격 제어
#  @BotFather 로 봇 생성 → 토큰 발급, Chat ID 는 tools/get_telegram_chat_id.py 로 확인
# ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_INSTANCE_NAME=            # 선택 — 알림 머리말(여러 대 운영 시 구분)

# ---------------------------------------------------------------------
# [선택] Google Gemini — AI 기능 전체(미설정 시 AI 메뉴만 비활성)
#  https://aistudio.google.com → Get API key
# ---------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=                      # 선택 (기본 gemini-flash-latest)
GEMINI_FALLBACK_MODEL=             # 선택 — 429(한도 초과) 시 자동 전환

# ---------------------------------------------------------------------
# [선택] OpenDART 전자공시 — 공시·배당·실적·재무 (https://opendart.fss.or.kr)
#  가입 즉시 무료 발급, 40자리 인증키. 일일 20,000건.
# ---------------------------------------------------------------------
DART_API_KEY=your_dart_api_key_here

# ---------------------------------------------------------------------
# [선택] FRED — 미국 경제지표 발표일정 (https://fredaccount.stlouisfed.org/apikeys)
#  미설정 시 미국 지표 일정만 빠지고 FOMC·국내 일정은 그대로 표시된다.
# ---------------------------------------------------------------------
FRED_API_KEY=

# ---------------------------------------------------------------------
# [선택] TradingView 계정 — 지수·미국채 조회(tvDatafeed)를 로그인 모드로
#  별도 발급이 아니라 기존 계정의 ID/PW. 토큰은 data/tv_token.json 에 7일 캐시된다.
# ---------------------------------------------------------------------
TV_USERNAME=
TV_PASSWORD=

# ---------------------------------------------------------------------
# [선택] KRX 정보데이터시스템 (https://data.krx.co.kr 회원 계정)
#  API 키가 아니라 웹 로그인 ID/비밀번호다. 무료 회원가입 후 그대로 넣는다.
#  켜면 다음이 KRX 공식 값으로 바뀐다 — 과거 일별 수급(백테스트 스마트머니),
#  KRX 금현물 OHLC·거래량, 코스피200/코스닥150 확정 봉, V코스피200, 상장 종목 목록.
#  미설정 시 전부 대체 소스로 조용히 폴백하므로 동작은 같지만 데이터 품질이 달라진다.
#  ※ 비밀번호이므로 다른 곳에 쓰지 않는 전용 계정을 권한다.
# ---------------------------------------------------------------------
KRX_ID=
KRX_PW=

# ---------------------------------------------------------------------
# [선택] 매매일지 웹서버 연동 (stock-memo)
#  URL·KEY 가 둘 다 있고 메뉴 스위치가 켜져야 동작한다.
#  JOURNAL_SOURCE 는 기기(설치)마다 달라야 한다 — 같으면 백필 기준점이 서로를 덮는다.
# ---------------------------------------------------------------------
JOURNAL_API_URL=
JOURNAL_API_KEY=
JOURNAL_SOURCE=my-stock-hts
JOURNAL_BOT_ID=                    # 선택 (기본 JOURNAL_SOURCE)
JOURNAL_BOT_LABEL=                 # 선택 — 웹 표시명(기본 자동 생성)
JOURNAL_SYNC_SIMULATION=0          # 1이면 모의투자 체결도 전송
